# Local cargo run (default): SQLite file — no Docker needed.
DATABASE_URL=sqlite:./data/jarvis.db?mode=rwc

# OCI / Docker production uses Postgres instead, e.g.:
# DATABASE_URL=postgres://jarvis:change-me-strong@postgres:5432/jarvis
# and build with: cargo build --release --no-default-features --features db-postgres

PORT=8080
RUST_LOG=jarvis_api=info,tower_http=info
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=

LLM_USER_RPM=5
LLM_USER_DAILY=50
LLM_GLOBAL_RPM=20
LLM_GLOBAL_DAILY=200
LLM_MAX_INPUT_CHARS=4000
LLM_CONTEXT_MESSAGES=20
LLM_MAX_INFLIGHT=3
