# Local cargo run (default): SQLite file — no Docker needed.
DATABASE_URL=sqlite:./data/jarvis.db?mode=rwc

# OCI / Docker production uses Postgres instead, e.g.:
# DATABASE_URL=postgres://jarvis:change-me-strong@postgres:5432/jarvis
# and build with: cargo build --release --no-default-features --features db-postgres

PORT=8080
RUST_LOG=jarvis_api=info,tower_http=info
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# Free-tier pool. A provider joins when its API key is set. Each turn picks one
# model from that pool based on the task, free-tier quota, prompt size, and
# cooldowns after provider errors. A failed call tries the next best fit.
# Optional allow-list. Empty = every key that is set.
# LLM_PROVIDERS=gemini,groq
# Legacy single name, used only when no API key is set yet.
GEMINI_API_KEY=
GROQ_API_KEY=
# Pin one model id to skip task routing. Leave empty to let Jarvis choose.
LLM_MODEL=

LLM_USER_RPM=5
LLM_USER_DAILY=50
LLM_GLOBAL_RPM=20
LLM_GLOBAL_DAILY=200
LLM_MAX_INPUT_CHARS=4000
LLM_CONTEXT_MESSAGES=20
LLM_MAX_INFLIGHT=3

# Admin terminal target: container | host (OCI compose forces host)
JARVIS_HOST_EXEC=container
