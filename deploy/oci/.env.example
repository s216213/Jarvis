# Copy to ~/jarvis/.env on the VM (manual) or deploy/oci/.env for local compose.
# Never commit a real .env.

# --- Postgres (compose service name: postgres) ---
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=jarvis
DATABASE_URL=postgres://jarvis:change-me-strong@postgres:5432/jarvis

# --- API ---
PORT=8080
RUST_LOG=jarvis_api=info,tower_http=info
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# --- Bootstrap first admin (only when users table is empty) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# --- LLM ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional pin; leave empty for auto latest chat-capable model
LLM_MODEL=

# Rate / quota limits (free-tier friendly defaults)
LLM_USER_RPM=5
LLM_USER_DAILY=50
LLM_GLOBAL_RPM=20
LLM_GLOBAL_DAILY=200
LLM_MAX_INPUT_CHARS=4000
LLM_CONTEXT_MESSAGES=20
LLM_MAX_INFLIGHT=3

# Admin terminal: container (API process) or host (OCI VM via nsenter).
# deploy/oci/docker-compose.yml sets host for the VM.
JARVIS_HOST_EXEC=container
